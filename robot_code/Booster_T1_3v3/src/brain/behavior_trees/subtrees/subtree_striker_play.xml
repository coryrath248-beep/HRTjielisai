<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="StrikerPlay">
      <ReactiveSequence>
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait_opponent_kickoff">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="normal_play">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence>
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <CalcKickDir shoot_goal_post_margin="0.4" />
                  <Sequence>
                     <ReactiveSequence>
                        <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" kick_point_dist="0.5" position_tolerance="0.15" orient_tolerance="0.16" kick_max_ball_yaw="0.24" kick_ball_x_tolerance="0.18" kick_ball_y_tolerance="0.12" force_kick_after_msecs="900" force_kick_tolerance_scale="2.2" force_kick_max_orient_error="0.38" force_kick_max_ball_yaw="0.42" />
                        <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                        <SmartFindBall _while="decision=='find'" reacquire_msecs="1200" local_scan_msecs="2000" global_scan_msecs="2000" head_interval_msecs="220" body_turn_speed="0.9" body_turn_msecs="650" body_pause_msecs="260" />
                     </ReactiveSequence>
                     <Assist _while="decision == 'assist'" vx_limit="0.8" vy_limit="0.5" />
                     <SimpleChase _while="decision == 'rush'" vx_limit="1.2" vy_limit="0.15" stop_dist="-0.1" stop_angle="0.3" />
                     <Chase _while="decision == 'chase'" vx_limit="1.0" vy_limit="0.35" vtheta_limit="1.0" dist="0.1" safe_dist="0.65" />
                     <PrepareKickPose _while="decision == 'position'" kick_point_dist="0.5" vx_limit="1.0" vy_limit="0.4" vtheta_limit="1.8" vtheta_gain="3.5" dist_tolerance="0.15" ball_path_clearance="0.35" ball_detour_lateral_offset="0.70" strict_behind_first="true" />
                     <FaceKickTarget _while="decision == 'orient'" angle_tolerance="0.16" vtheta_limit="1.8" vtheta_gain="4.0" />
                     <Adjust _while="decision == 'adjust'" turn_threshold="0.8" range="0.5" vx_limit="0.8" vy_limit="0.5" vtheta_limit="1.0" vtheta_factor="4.5" tangential_speed_far="0.6" tangential_speed_near="0.25" />
                     <Kick _while="decision == 'clear'" speed_limit="1.6" min_msec_kick="350" msecs_stablize="0" />
                     <Kick _while="decision == 'kick'" speed_limit="1.2" min_msec_kick="750" msecs_stablize="1000" />
                     <Kick _while="decision == 'cross'" speed_limit="0.5" min_msec_kick="250" />
                  </Sequence>
               </ReactiveSequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
