<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="GoalKeeperPlay">
      <ReactiveSequence>
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait_opponent_kickoff">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="normal_play">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait_opponent_kickoff_nested">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <SetVelocity />
               </ReactiveSequence>
               <Sequence _while="!wait_for_opponent_kickoff" name="normal_match">
                  <ReactiveSequence>
                     <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                     <CalcKickDir />
                     <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="4.0" setup_range="1.0" kick_point_dist="0.6" position_tolerance="0.18" orient_tolerance="0.15" ball_velocity_sample_count="10" />
                     <SmartFindBall _while="decision=='find'" reacquire_msecs="1200" local_scan_msecs="1500" global_scan_msecs="6500" head_interval_msecs="220" body_turn_speed="0.8" body_turn_msecs="550" body_pause_msecs="350" />
                     <GoalieBlock _while="decision == 'block'" vx_limit="0.45" vy_limit="0.85" vtheta_limit="1.5" />
                     <GoToGoalBlockingPosition _while="decision == 'retreat_near'" dist_to_goalline="0.8" theta_tolerance="0.6" vx_limit="0.7" vy_limit="0.3" />
                     <GoToGoalBlockingPosition _while="decision == 'retreat'" theta_tolerance="0.6" vx_limit="0.7" vy_limit="0.3" />
                     <Chase _while="decision == 'chase'" vx_limit="0.65" vy_limit="0.35" vtheta_limit="1.0" dist="0.1" safe_dist="0.65" />
                     <PrepareKickPose _while="decision == 'position'" kick_point_dist="0.6" vx_limit="0.6" vy_limit="0.5" vtheta_limit="1.5" vtheta_gain="3.0" dist_tolerance="0.18" ball_path_clearance="0.35" ball_detour_lateral_offset="0.70" />
                     <FaceKickTarget _while="decision == 'orient'" angle_tolerance="0.15" vtheta_limit="1.8" vtheta_gain="4.0" />
                     <Adjust _while="decision =='adjust'" turn_threshold="0.8" range="0.5" vx_limit="0.8" vy_limit="0.6" vtheta_limit="1.0" vtheta_factor="4.5" tangential_speed_far="0.9" tangential_speed_near="0.3" />
                     <Kick _while="decision == 'kick'" speed_limit="1.2" min_msec_kick="750" />
                  </ReactiveSequence>
               </Sequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
